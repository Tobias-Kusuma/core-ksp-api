# ===== API SERVICE =====
# app port
PORT="127.0.0.1:8080"

# key untuk security
JWTKEY="contoh-jwt-key"
SIGNSECRET="contoh-sign-secret"


# ===== REDIS SERVICE =====
# gunakan "127.0.0.1" jika run lokal, atau "redis" jika di dalam Docker Compose
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"


# ===== SQL SERVICE =====
# main db
MAIN_DBSERVER="host-address"
MAIN_DBPORT="port"
MAIN_DBUSER="username"
MAIN_DBPASSWORD="pass"
MAIN_DBNAME="nama-db"

